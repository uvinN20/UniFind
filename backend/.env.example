NODE_ENV=development
PORT=5000

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/unifind

# Use a long random string in real deployments
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Comma separated list of allowed browser origins (leave empty to allow all in dev)
CLIENT_ORIGIN=http://localhost:5173

# Where uploaded item photos are stored
UPLOAD_DIR=./uploads

# An admin account is created automatically on start-up if these are set
ADMIN_NAME=UniFind Admin
ADMIN_EMAIL=admin@unifind.lk
ADMIN_PASSWORD=Admin@12345
